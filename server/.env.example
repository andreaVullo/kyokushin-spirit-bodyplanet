# Set secrets only in the hosting environment or in an untracked server/.env.
GITHUB_TOKEN=
ALLOWED_ORIGINS=https://andreavullo.github.io
HOST=127.0.0.1
PORT=8787
# Use a writable persistent volume in production.
LEADERBOARD_STORE=
# Leave disabled unless the trusted reverse proxy replaces X-Forwarded-For.
TRUST_PROXY=0
